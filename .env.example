# Test mint. Quotes auto-pay, so "Add test sats" is instant. No real money.
VITE_MINT_URL=https://testnut.cashu.space

# Supabase project (Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Demo exchange rate for the naira display
VITE_NGN_PER_SAT=1.6

# Short cycles so the refund path can be shown on stage
VITE_CYCLE_MINUTES=3
VITE_GRACE_MINUTES=2
